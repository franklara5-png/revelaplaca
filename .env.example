DATABASE_URL=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox
# Fornecedores de dado veicular.
#
# URL: aceita `{placa}` no meio (ex.: https://api.exemplo/v1/{placa}/dados).
# Sem `{placa}`, em GET a placa e concatenada no fim do caminho; em POST ela
# vai no corpo e a URL e usada como esta.
#
# METODO: GET (padrao) ou POST. A maioria dos fornecedores brasileiros usa
# POST com corpo JSON — confira a documentacao antes de assumir GET.
#
# HEADER_NOME / HEADER_VALOR: header extra, para quem exige um segundo token
# alem do Authorization. Ex.: a apibrasil.io pede `DeviceToken`.
#
# CAMPO_PLACA: nome do campo da placa no corpo do POST. Padrao "placa";
# use "plate" nos fornecedores de documentacao em ingles.
#
# O token ja e enviado como `Authorization: Bearer` E como `X-Api-Key` — nao
# precisa escolher, o fornecedor ignora o que nao reconhece.
FORNECEDOR_BASICO_URL=
FORNECEDOR_BASICO_TOKEN=
FORNECEDOR_BASICO_METODO=GET
FORNECEDOR_BASICO_HEADER_NOME=
FORNECEDOR_BASICO_HEADER_VALOR=
FORNECEDOR_BASICO_CAMPO_PLACA=
FORNECEDOR_PREMIUM_URL=
FORNECEDOR_PREMIUM_TOKEN=
FORNECEDOR_PREMIUM_METODO=GET
FORNECEDOR_PREMIUM_HEADER_NOME=
FORNECEDOR_PREMIUM_HEADER_VALOR=
FORNECEDOR_PREMIUM_CAMPO_PLACA=
# Nome do parceiro exibido no rodape do relatorio pago. Opcional: sem ele o
# relatorio mostra "Parceiro veicular autorizado".
FORNECEDOR_PREMIUM_NOME=

# Turnstile (Cloudflare). Sao DUAS chaves e os nomes importam:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY  -> publica, vai para o navegador
#   TURNSTILE_SECRET_KEY            -> secreta, validacao no servidor
#
# ATENCAO NA VERCEL: NEXT_PUBLIC_* e embutida no BUILD, nao lida em runtime.
# Duas consequencias:
#   1. mudar o valor exige REDEPLOY, senao o build antigo continua sem ela;
#   2. NAO marque como "Sensitive" — variavel sensivel nao fica disponivel no
#      build, entao ela nao seria embutida e o widget nao renderiza. O sintoma
#      e o mesmo de nao ter configurado nada.
# Sem as duas, TODA consulta gratuita responde 403 em producao.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Salt do hash de IP. Sem ela o codigo RECUSA operar em producao, de proposito:
# com salt conhecido o hash de IP e reversivel. Gere com:
#   node scripts/gera-hash-admin.mjs "sua-senha"
IP_HASH_SALT=
FIPE_IMPORT_DELAY_MS=350
FIPE_IMPORT_LIMIT=
BREVO_API_KEY=
BREVO_SENDER_NAME=RevelaPlaca
BREVO_SENDER_EMAIL=noreply@revelaplaca.com.br
NEXT_PUBLIC_SITE_URL=https://revelaplaca.com.br
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
CRON_SECRET=

# Hermes (dashboard interno) — mesmo valor usado nos outros sites Altivia
HERMES_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://revelaplaca.com.br
NEXT_PUBLIC_APP_URL=https://revelaplaca.com.br

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
